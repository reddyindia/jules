<?xml version="1.0"?>
<ruleset name="WordPress Tahlilgar Analyzer Plugin">
    <description>PHPCS configuration for the Tahlilgar Analyzer plugin.</description>

    <!-- Exclude paths -->
    <exclude-pattern>*/vendor/*</exclude-pattern>
    <exclude-pattern>*/node_modules/*</exclude-pattern>

    <!-- Include the WordPress-Core standard -->
    <rule ref="WordPress-Core">
        <!-- You can exclude specific sniffs here if needed -->
    </rule>

    <!-- Check all PHP files in the plugin directory -->
    <file>./</file>

    <!-- Show progress -->
    <arg value="p"/>
    <!-- Show sniff codes in reports -->
    <arg value="s"/>

    <!-- Set severity to 1 to show all errors and warnings -->
    <arg name="severity" value="1"/>
</ruleset>